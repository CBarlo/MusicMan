[Unit]
Description=Music Man Pi Status LED
After=local-fs.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/musicman
ExecStart=/home/pi/musicman/venv/bin/python3 -u /home/pi/musicman/pi_status_led.py
# Backup "safe to unplug" signal, independent of the main process — see
# pi_status_led_stop_hook.py's own header for why this exists. Runs before
# the main process is sent SIGTERM; harmless if it races the main process's
# own normal operation, since whichever runs last still leaves the pixel
# white either way.
ExecStop=/home/pi/musicman/venv/bin/python3 /home/pi/musicman/pi_status_led_stop_hook.py
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
